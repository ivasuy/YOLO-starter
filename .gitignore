.claude/worktrees/
.claude/agent-memory-local/
.codex/sessions/
.codex/tmp/
.entire/
.env
.env.*
!.env.example
*.log
node_modules/
dist/
build/
coverage/
__pycache__/
.DS_Store

# Generated by codex-org runs. The four dirs stay tracked as empty
# scaffolding (via .gitkeep) but agent output never gets staged into a PR.
agent-runs/*
!agent-runs/.gitkeep

.worktrees/*
!.worktrees/.gitkeep

docs/superpowers/specs/*
!docs/superpowers/specs/.gitkeep

docs/superpowers/plans/*
!docs/superpowers/plans/.gitkeep

# workflow/ keeps only the canonical template config; agent-generated
# workflow files (e.g. ad-hoc tasks.json runs) never get staged.
workflow/*
!workflow/org.defaults.json
!workflow/tasks.example.json
